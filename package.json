{
  "name": "@knorby/nlm-drugs-client",
  "version": "0.0.0",
  "description": "Typed TypeScript clients for NLM and public biomedical information services",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knorby/nlm-drugs-client.git"
  },
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup --watch",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc -p tsconfig.test.json",
    "typecheck:package": "npm run build && tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --strict --skipLibCheck false tests/cjs-consumer.cts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:services": "npm run test:coverage && npm run test:live",
    "check:expo": "npm run build && npm ci --prefix examples/expo-compat --ignore-scripts && npm run check --prefix examples/expo-compat",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
